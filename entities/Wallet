{
  "name": "Wallet",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "transfer_in",
        "used"
      ],
      "description": "Type of wallet entry"
    },
    "person_name": {
      "type": "string",
      "description": "Person who transferred money"
    },
    "purpose": {
      "type": "string",
      "description": "What money was used for"
    },
    "amount": {
      "type": "number",
      "description": "Amount in PKR"
    }
  },
  "required": [
    "type",
    "amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "id": {
          "$exists": true
        }
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
